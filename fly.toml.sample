# fly.toml.sample — example config for convexchat
# Copy to fly.toml (and fill values) when deploying locally.

app = "convexchat"
primary_region = "nrt"

[build]
  dockerfile = "Dockerfile"
  [build.args]
    # Replace with your Convex deployment URL (dev or prod)
    VITE_CONVEX_URL = "https://<your-convex-deployment>.convex.cloud"

[http_service]
  internal_port = 80
  force_https = true
  auto_stop_machines = "stop"
  auto_start_machines = true
  min_machines_running = 0
  processes = ["app"]

  [http_service.concurrency]
    type = "requests"
    hard_limit = 250
    soft_limit = 200

  [[http_service.checks]]
    interval = "30s"
    timeout = "5s"
    grace_period = "5s"
    method = "GET"
    path = "/"

[[vm]]
  size = "shared-cpu-1x"
  memory = "256mb"
  cpu_kind = "shared"
  cpus = 1
